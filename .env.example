# =========================================================
# CONFIGURACIÓN DE SUPABASE Y ENTORNO (ODONTO-DEMO)
# =========================================================

# URL de tu proyecto de Supabase (Project Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Anon Key (Project Settings -> API -> anon public)
# Es segura para usar en el navegador y respeta las políticas RLS de PostgreSQL
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service Role Key (Project Settings -> API -> service_role secret)
# NUNCA compartir ni exponer en el cliente. Usado únicamente en Server Actions administrativas
SUPABASE_SERVICE_ROLE_KEY=

# URL de la aplicación local para callbacks de autenticación
NEXT_PUBLIC_APP_URL=http://localhost:3000
